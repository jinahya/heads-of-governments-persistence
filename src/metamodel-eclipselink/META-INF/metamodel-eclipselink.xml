<!-- Read by EclipseLink's static metamodel processor alone, the default one; jakartaee-11-metamodel-hibernate-orm
     skips it. The build copies it into target/classes before compile (the processor reads only from there) and keeps
     it out of the jar. It is not META-INF/persistence.xml, so no provider ever reads it. It lists no class: the
     processor then generates the metamodel of every managed class it compiles. -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 ${persistence.schemaLocation}"
             version="${persistence.version}">
  <persistence-unit name="metamodel"/>
</persistence>

