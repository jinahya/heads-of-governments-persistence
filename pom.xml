<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jinahya</groupId>
    <artifactId>jinahya-parent</artifactId>
    <version>1.1.2</version>
  </parent>

  <groupId>io.github.jinahya</groupId>
  <artifactId>heads-of-governments-persistence</artifactId>
  <version>0.6.12-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>${project.artifactId}</name>
  <description>Heads of Governments Persistence</description>
  <url>https://github.com/jinahya/${project.artifactId}</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>Jinahya, Inc.</name>
    <url>https://jinahya.com</url>
  </organization>

  <developers>
    <developer>
      <id>onacit</id>
      <name>Kwon, Jin</name>
      <email>onacit@gmail.com</email>
      <url>https://github.com/onacit</url>
      <roles>
        <role>developer</role>
      </roles>
      <timezone>Asia/Seoul</timezone>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git@github.com:jinahya/${project.artifactId}.git</connection>
    <developerConnection>scm:git:git@github.com:jinahya/${project.artifactId}.git</developerConnection>
    <url>https://github.com/jinahya/${project.artifactId}</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/jinahya/${project.artifactId}/issues</url>
  </issueManagement>

  <properties>
    <!-- https://endoflife.date/eclipse-temurin -->
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
    <maven.compiler.release>${maven.compiler.target}</maven.compiler.release>
    <maven.compiler.testSource>25</maven.compiler.testSource>
    <maven.compiler.testTarget>${maven.compiler.testSource}</maven.compiler.testTarget>
    <maven.compiler.testRelease>${maven.compiler.testSource}</maven.compiler.testRelease>
    <!-- The sources are clean under -Xdoclint:all; keep them that way. -->
    <doclint>all</doclint>
    <sonar.organization>jinahya-github</sonar.organization>
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <!-- The per-generation values (version.jakarta.jakartaee-bom, version.org.hibernate.orm,
         persistence.version, persistence.schemaLocation) are NOT here: each jakarta-ee-NN profile
         sets them, and nothing defaults them, so a build with no generation active fails instead of
         quietly picking one. -->
    <!-- The static metamodel generator on the annotation processor path; EclipseLink's unless
         jakartaee-11-metamodel-hibernate-orm says otherwise. It only generates the *_ classes: the provider is
         Hibernate ORM either way. The version comes from the generation profile. -->
    <metamodel.generator.groupId>org.eclipse.persistence</metamodel.generator.groupId>
    <metamodel.generator.artifactId>org.eclipse.persistence.jpa.modelgen.processor</metamodel.generator.artifactId>
    <metamodel.generator.version>${version.org.eclipse.persistence}</metamodel.generator.version>
    <version.maven-failsafe>${version.maven-surefire}</version.maven-failsafe>
    <version.maven-surefire>3.6.1</version.maven-surefire>
    <!-- https://central.sonatype.com/artifact/org.xerial/sqlite-jdbc/versions -->
    <version.org.xerial.sqlite-jdbc>3.54.1.0</version.org.xerial.sqlite-jdbc>
    <!-- https://central.sonatype.com/artifact/org.assertj/assertj-core/versions -->
    <version.org.assertj>4.0.0-M1</version.org.assertj>
    <!-- https://central.sonatype.com/artifact/nl.jqno.equalsverifier/equalsverifier-nodep/versions -->
    <version.nl.jqno.equalsverifier>4.5.2</version.nl.jqno.equalsverifier>
    <!-- https://central.sonatype.com/artifact/org.junit/junit-bom/versions -->
    <version.org.junit>6.1.3</version.org.junit>
    <!-- https://central.sonatype.com/artifact/org.projectlombok/lombok/versions -->
    <version.org.projectlombok>1.18.48</version.org.projectlombok>
    <!-- https://central.sonatype.com/artifact/org.slf4j/slf4j-bom/versions -->
    <version.org.slf4j>2.0.20</version.org.slf4j>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency><!-- https://central.sonatype.com/artifact/jakarta.platform/jakarta.jakartaee-bom/versions -->
        <groupId>jakarta.platform</groupId>
        <artifactId>jakarta.jakartaee-bom</artifactId>
        <version>${version.jakarta.jakartaee-bom}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${version.org.assertj}</version>
      </dependency>
      <dependency><!-- the shaded artifact: no byte-buddy or objenesis of its own to converge -->
        <groupId>nl.jqno.equalsverifier</groupId>
        <artifactId>equalsverifier-nodep</artifactId>
        <version>${version.nl.jqno.equalsverifier}</version>
      </dependency>
      <dependency><!-- SQLiteDialect; moves with hibernate-core -->
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-community-dialects</artifactId>
        <version>${version.org.hibernate.orm}</version>
      </dependency>
      <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-core</artifactId>
        <version>${version.org.hibernate.orm}</version>
      </dependency>
      <dependency><!-- https://search.maven.org/artifact/org.junit/junit-bom -->
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.org.junit}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-bom</artifactId>
        <version>${version.org.slf4j}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${version.org.xerial.sqlite-jdbc}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>nl.jqno.equalsverifier</groupId>
      <artifactId>equalsverifier-nodep</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${version.org.projectlombok}</version>
      <scope>provided</scope>
      <!-- compile-time only, for main and test sources alike; never transitive -->
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
      <!-- for @Slf4j on main classes -->
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk-platform-logging</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
        <!-- heads_of_governments.sqlite3 is binary; filtering would rewrite it -->
        <filtering>false</filtering>
      </resource>
    </resources>
    <testResources>
      <testResource>
        <directory>${project.basedir}/src/test/resources</directory>
        <filtering>true</filtering>
      </testResource>
    </testResources>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-compiler-plugin/versions -->
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-javadoc-plugin/versions -->
          <version>3.12.0</version>
          <configuration>
            <additionalOptions>
              <additionalOption>-Xdoclint:${doclint},-missing</additionalOption>
            </additionalOptions>
            <failOnError>true</failOnError>
            <failOnWarnings>true</failOnWarnings>
            <!-- A bare `javadoc:javadoc` / `javadoc:test-javadoc` from the command line lands in the -->
            <!-- default-cli execution, which no reportSet reaches and which cannot be scoped per goal. -->
            <!-- So this level carries what BOTH goals can live with: the test sources are all -->
            <!-- package-private, which `protected` finds nothing in, and their constructors and @Test -->
            <!-- methods carry no javadoc by convention. The strict settings live in the site's main -->
            <!-- reportSet below, which is what actually gates the published apidocs. -->
            <show>package</show>
            <!-- The generated static metamodel is not ours to document: every member of it carries -->
            <!-- a bare @see and no main description, which -Xdoclint:all reports. It shares the -->
            <!-- package with the entities, so excludePackageNames cannot reach it; exclude by file. -->
            <sourceFileExcludes>
              <sourceFileExclude>**/*_.java</sourceFileExclude>
            </sourceFileExcludes>
            <links>
              <link>https://jakarta.ee/specifications/platform/11/apidocs/</link>
            </links>
            <release>${maven.compiler.testRelease}</release>
            <tags>
              <tag>
                <name>apiNote</name>
                <placement>a</placement>
                <head>API Note:</head>
              </tag>
              <tag>
                <name>implSpec</name>
                <placement>a</placement>
                <head>Implementation Requirements:</head>
              </tag>
              <tag>
                <name>implNote</name>
                <placement>a</placement>
                <head>Implementation Note:</head>
              </tag>
            </tags>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-jar-plugin/versions -->
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-project-info-reports-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-project-info-reports-plugin/versions -->
          <version>3.9.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-site-plugin/versions -->
          <version>3.21.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>2.22.0</version>
          <configuration>
            <processDependencyManagementTransitive>false</processDependencyManagementTransitive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>4.0.0.4121</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.15</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- src/test/java-exercises holds the tests that answer the exercises of src/test/sql-exercises, a class per
           .sql file; src/test/java keeps to the persistence tests. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-exercises-test-source</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src/test/java-exercises</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The processor reads its descriptor from target/classes alone, before the test descriptor is there,
           and generates nothing without one. So a descriptor of its own goes there first, under a name no
           provider reads, and stays out of the jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-metamodel-eclipselink-descriptor</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/metamodel-eclipselink</directory>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>META-INF/metamodel-eclipselink.xml</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${version.org.projectlombok}</version>
            </path>
            <path><!-- the static metamodel generator; see the jakarta-ee-NN-metamodel-* profiles -->
              <groupId>${metamodel.generator.groupId}</groupId>
              <artifactId>${metamodel.generator.artifactId}</artifactId>
              <version>${metamodel.generator.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Xlint</arg>
            <!-- for EclipseLink's metamodel processor; see copy-metamodel-eclipselink-descriptor -->
            <arg>-Aeclipselink.persistencexml=META-INF/metamodel-eclipselink.xml</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>enforce-dependency-convergence</id>
            <configuration>
              <rules>
                <dependencyConvergence />
              </rules>
            </configuration>
            <goals>
              <goal>enforce</goal>
            </goals>
          </execution>
          <execution>
            <id>enforce-require-java-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-require-maven-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <!-- a -P naming a profile that does not exist is silently ignored by Maven; this turns
                 that into a build failure. The Jakarta EE profile ids are named from the
                 _mvn_jakartaee_11_*.sh scripts and from the CI matrix, so a rename that misses one
                 of them would otherwise just run the default profile and look green. -->
            <id>enforce-require-profile-ids-exist</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProfileIdsExist />
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${version.maven-surefire}</version>
        <configuration>
          <skipAfterFailureCount>1</skipAfterFailureCount>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.7.1</version>
        <configuration>
          <licenseName>apache_v2</licenseName>
          <!-- A .sql header opens and closes with a dash after the comment marker, the mysql style, in every module:
               the default sql style would open and close with three dashes, which MySQL does not take for a comment. -->
          <extraExtensions>
            <sql>mysql</sql>
          </extraExtensions>
          <!-- src alone: by default the plugin also walks target/generated-sources, and would put a header on every
               generated metamodel class, which the next build throws away. -->
          <roots>
            <root>src</root>
          </roots>
          <excludes>
            <exclude>**/*.json</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>default-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>default-report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <reporting>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jxr-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <reportSets>
          <reportSet>
            <id>main</id>
            <configuration>
              <!-- The published apidocs: public API only, and every element of it documented. -->
              <show>protected</show>
              <additionalOptions combine.self="override">
                <additionalOption>-Xdoclint:${doclint}</additionalOption>
              </additionalOptions>
            </configuration>
            <reports>
              <report>javadoc-no-fork</report>
            </reports>
          </reportSet>
          <reportSet>
            <id>tests</id>
            <configuration>
              <!-- Every test class is package-private, so the default `protected` finds nothing to -->
              <!-- document, and javadoc reports that as an error. -->
              <show>package</show>
              <!-- Package-private constructors and @Test methods carry no javadoc by convention, so -->
              <!-- check references and syntax rather than presence. combine.self is required: without -->
              <!-- it Maven merges the list and the plugin-level -Xdoclint:${doclint} comes along too. -->
              <additionalOptions combine.self="override">
                <additionalOption>-Xdoclint:all,-missing</additionalOption>
              </additionalOptions>
              <!-- test-javadoc links the test apidocs to the main ones, ../apidocs, whenever those exist, -->
              <!-- and no parameter turns that off. The test sources are documented in the unnamed module -->
              <!-- and the main ones in a named module, which javadoc warns of, outside doclint. So a -->
              <!-- warning does not fail this report; an error, a broken reference among them, does. -->
              <failOnWarnings>false</failOnWarnings>
            </configuration>
            <reports>
              <report>test-javadoc-no-fork</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.28.0</version>
        <configuration>
          <!-- Unsupported targetJdk value '21'. -->
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <reportSets>
          <reportSet>
            <reports>
              <report>report</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
    </plugins>
  </reporting>

  <profiles>
    <profile>
      <id>failsafe</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>${version.maven-failsafe}</version>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <skipAfterFailureCount>1</skipAfterFailureCount>
              <trimStackTrace>false</trimStackTrace>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- ===================================================================== jakarta ee ==== -->
    <!-- One profile per Jakarta EE generation; beside them, only the jakarta-ee-NN-metamodel-* profiles below,
         which carry the generation in their name since each generation brings its own provider versions. The
         dependencies are the
         same in every generation and are declared once, above; a profile sets only the versions that
         go with its generation. jakartaee-11 is the only one so far, and is active by default. -->
    <profile>
      <id>jakartaee-11</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <!-- https://jakarta.ee/specifications/platform/11/ -->
        <!-- https://central.sonatype.com/artifact/jakarta.platform/jakarta.jakartaee-bom/versions -->
        <!-- 11.0.0 manages: jakarta.persistence-api 3.2.0 -->
        <version.jakarta.jakartaee-bom>11.0.0</version.jakarta.jakartaee-bom>
        <!-- https://hibernate.org/orm/releases/ -->
        <!-- https://central.sonatype.com/artifact/org.hibernate.orm/hibernate-platform/versions -->
        <!-- Jakarta Persistence: 3.2 / Jakarta EE: 11 -->
        <version.org.hibernate.orm>7.4.15.Final</version.org.hibernate.orm>
        <!-- https://eclipse.dev/eclipselink/releases/index.html -->
        <!-- https://central.sonatype.com/artifact/org.eclipse.persistence/org.eclipse.persistence.jpa/versions -->
        <!-- Jakarta Persistence: 3.2 / Jakarta EE: 11; the metamodel processor only, not a provider -->
        <version.org.eclipse.persistence>5.0.2</version.org.eclipse.persistence>
        <persistence.version>3.2</persistence.version>
        <persistence.schemaLocation>https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd</persistence.schemaLocation>
      </properties>
    </profile>

    <!-- ====================================================================== metamodel ==== -->
    <!-- Which annotation processor generates the static metamodel (Office_, Head_), and nothing else: the
         persistence provider is Hibernate ORM in both, and will stay so. Name one alongside the generation,
         -Pjakartaee-11,jakartaee-11-metamodel-hibernate-orm; with neither named, the root picks EclipseLink's,
         which is the default. jakartaee-11-metamodel-eclipselink only says so explicitly. -->
    <profile>
      <id>jakartaee-11-metamodel-hibernate-orm</id>
      <properties>
        <metamodel.generator.groupId>org.hibernate.orm</metamodel.generator.groupId>
        <metamodel.generator.artifactId>hibernate-jpamodelgen</metamodel.generator.artifactId>
        <metamodel.generator.version>${version.org.hibernate.orm}</metamodel.generator.version>
      </properties>
      <build>
        <plugins>
          <!-- hibernate-jpamodelgen reads @Entity directly and needs no descriptor -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-metamodel-eclipselink-descriptor</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <compilerArgs combine.self="override">
                <arg>-Xlint</arg>
              </compilerArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>jakartaee-11-metamodel-eclipselink</id>
      <!-- Naming any profile, -Pjakartaee-11 included, switches this off; the root <properties> and build carry the
           same values, so EclipseLink's processor stays the default either way. -->
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <metamodel.generator.groupId>org.eclipse.persistence</metamodel.generator.groupId>
        <metamodel.generator.artifactId>org.eclipse.persistence.jpa.modelgen.processor</metamodel.generator.artifactId>
        <metamodel.generator.version>${version.org.eclipse.persistence}</metamodel.generator.version>
      </properties>
    </profile>
  </profiles>
</project>
